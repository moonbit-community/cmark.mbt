import {
  "moonbitlang/core/bench",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbit-community/cmarkwrap/lib",
}

pkgtype(kind: "executable")

options(
  targets: {
    "ident_wasm.mbt": [ "wasm" ],
    "ident_wasm_gc.mbt": [ "wasm-gc" ],
    "ident_js.mbt": [ "js" ],
    "ident_native.mbt": [ "native" ],
  },
)
